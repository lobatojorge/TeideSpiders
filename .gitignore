# Datos crudos (pueden ser grandes o contener datos sensibles)
# Descomentar si NO se quieren versionar los datos originales:
# data/raw/
# Excluir SOLO el contenido, no el directorio (los .gitkeep se conservan)
data/raw/*
!data/raw/.gitkeep

# Datos procesados (derivados regenerables — siempre excluir)
data/processed/*
!data/processed/.gitkeep

# Outputs regenerables
output/plots/
output/tables/
output/cache/

# Archivos temporales de R
.Rhistory
.RData
*.Rproj.user/
.Rproj.user

# renv (el lockfile SÍ se versiona; la librería NO)
renv/library/
renv/staging/

# Quarto
reports/*_files/
reports/.quarto/

# OS
.DS_Store
Thumbs.db


# Datos sensibles (descomentar si se necesita)
# data/*.xlsx
# data/RAxML_bestTree.result
